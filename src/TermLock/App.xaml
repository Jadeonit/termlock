<Application x:Class="TermLock.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <FontFamily x:Key="TerminalFont">Consolas</FontFamily>
        <SolidColorBrush x:Key="TermGreen" Color="#00FF66" />
        <SolidColorBrush x:Key="TermDim" Color="#0A8F3C" />
        <SolidColorBrush x:Key="TermRed" Color="#FF5555" />
        <SolidColorBrush x:Key="TermBg" Color="#000000" />
    </Application.Resources>
</Application>
