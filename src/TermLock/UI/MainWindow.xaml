<Window x:Class="TermLock.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TermLock"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{StaticResource TermBg}"
        Foreground="{StaticResource TermGreen}"
        FontFamily="{StaticResource TerminalFont}"
        FontSize="14"
        WindowStartupLocation="Manual"
        Cursor="Arrow">

    <Grid Margin="40,28,40,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ASCII banner -->
        <TextBlock x:Name="BannerText"
                   Grid.Row="0"
                   FontSize="13"
                   LineHeight="15"
                   Foreground="{StaticResource TermGreen}"
                   TextOptions.TextFormattingMode="Display" />

        <!-- version / host / uptime / clock -->
        <TextBlock x:Name="MetaText"
                   Grid.Row="1"
                   Margin="0,12,0,18"
                   FontSize="13"
                   Foreground="{StaticResource TermDim}" />

        <!-- body: stats on the left, matrix stream on the right -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="StatsText"
                       Grid.Column="0"
                       FontSize="13"
                       LineHeight="20"
                       Foreground="{StaticResource TermGreen}"
                       TextOptions.TextFormattingMode="Display" />

            <Border Grid.Column="1"
                    Margin="28,0,0,0"
                    Padding="12,10"
                    BorderBrush="#123F24"
                    BorderThickness="1">
                <TextBlock x:Name="MatrixText"
                           FontSize="12"
                           LineHeight="14"
                           Foreground="#0A8F3C"
                           TextOptions.TextFormattingMode="Display" />
            </Border>
        </Grid>

        <!-- prompt -->
        <StackPanel Grid.Row="3"
                    Margin="0,20,0,0"
                    Orientation="Horizontal">
            <TextBlock Text="> passphrase: "
                       Foreground="{StaticResource TermGreen}" />
            <TextBlock x:Name="InputText"
                       Foreground="{StaticResource TermGreen}" />
            <TextBlock x:Name="CursorText"
                       Text="_"
                       Foreground="{StaticResource TermGreen}" />

            <!-- Invisible focus sink: it owns real keyboard input, while the
                 visible line above only renders bullets. -->
            <PasswordBox x:Name="HiddenInput"
                         Width="1"
                         Height="1"
                         Opacity="0"
                         IsTabStop="False"
                         Focusable="True" />
        </StackPanel>

        <!-- auth status -->
        <TextBlock x:Name="StatusText"
                   Grid.Row="4"
                   Margin="0,12,0,0"
                   FontSize="13"
                   Foreground="{StaticResource TermDim}" />

        <!-- static hints -->
        <TextBlock Grid.Row="5"
                   Margin="0,6,0,0"
                   FontSize="12"
                   Foreground="#0A5C28"
                   Text="Enter = unlock   ·   Esc = clear line   ·   Ctrl+Alt+Shift+L = lock" />
    </Grid>
</Window>
