<Window x:Class="TermLock.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TermLock.UI"
        Title="TermLock"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{StaticResource TermBg}"
        Foreground="{StaticResource TermGreen}"
        FontFamily="{StaticResource TerminalFont}"
        FontSize="14"
        WindowStartupLocation="Manual"
        Cursor="Arrow">

    <Grid Margin="40,28,40,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ASCII banner -->
        <TextBlock x:Name="BannerText"
                   Grid.Row="0"
                   FontSize="13"
                   LineHeight="15"
                   Foreground="{StaticResource TermGreen}"
                   TextOptions.TextFormattingMode="Display" />

        <!-- version / host / uptime / clock -->
        <TextBlock x:Name="MetaText"
                   Grid.Row="1"
                   Margin="0,12,0,18"
                   FontSize="13"
                   Foreground="{StaticResource TermDim}" />

        <!-- body: the matrix fills the whole body; stats sit on a translucent panel -->
        <Grid Grid.Row="2">
            <local:MatrixRain x:Name="Matrix"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              ClipToBounds="True" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="#F7000000"
                        Padding="18,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="StatsText"
                                   Grid.Row="0"
                                   FontSize="13"
                                   LineHeight="20"
                                   Foreground="{StaticResource TermGreen}"
                                   TextOptions.TextFormattingMode="Display" />

                        <TextBlock x:Name="ArtText"
                                   Grid.Row="2"
                                   Margin="0,18,0,0"
                                   FontSize="11"
                                   LineHeight="13"
                                   Foreground="#0A7A34"
                                   TextOptions.TextFormattingMode="Display" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- prompt -->
        <StackPanel Grid.Row="3"
                    Margin="0,20,0,0"
                    Orientation="Horizontal">
            <TextBlock Text="> passphrase: "
                       Foreground="{StaticResource TermGreen}" />
            <TextBlock x:Name="InputText"
                       Foreground="{StaticResource TermGreen}" />
            <TextBlock x:Name="CursorText"
                       Text="_"
                       Foreground="{StaticResource TermGreen}" />
            <TextBlock x:Name="LayoutText"
                       Margin="24,0,0,0"
                       Text="[--]"
                       Foreground="{StaticResource TermDim}" />

            <!-- Invisible focus sink: it owns real keyboard input, while the
                 visible line above only renders bullets. -->
            <PasswordBox x:Name="HiddenInput"
                         Width="1"
                         Height="1"
                         Opacity="0"
                         IsTabStop="False"
                         Focusable="True" />
        </StackPanel>

        <!-- auth status -->
        <TextBlock x:Name="StatusText"
                   Grid.Row="4"
                   Margin="0,12,0,0"
                   FontSize="13"
                   Foreground="{StaticResource TermDim}" />

        <!-- static hints -->
        <TextBlock Grid.Row="5"
                   Margin="0,6,0,0"
                   FontSize="12"
                   Foreground="#0A5C28"
                   Text="Enter = unlock   ·   Esc = clear line   ·   Alt+Shift = layout   ·   Caps x2 / Ctrl+Alt+Shift+L = lock" />
    </Grid>
</Window>
