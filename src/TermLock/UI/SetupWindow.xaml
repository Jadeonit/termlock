<Window x:Class="TermLock.UI.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TermLock setup"
        Width="640"
        Height="420"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="True"
        Background="Black"
        Foreground="#00FF66"
        FontFamily="Consolas"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#050505" />
            <Setter Property="Foreground" Value="#00FF66" />
            <Setter Property="CaretBrush" Value="#00FF66" />
            <Setter Property="BorderBrush" Value="#0A8F3C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="PasswordChar" Value="●" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="Black" />
            <Setter Property="Foreground" Value="#00FF66" />
            <Setter Property="BorderBrush" Value="#0A8F3C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root"
          Margin="34,28"
          MouseLeftButtonDown="OnDrag">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="TERMLOCK // PASSPHRASE"
                   FontSize="20"
                   Foreground="#00FF66" />

        <TextBlock Grid.Row="1"
                   Margin="0,8,0,20"
                   Text="Set or replace the passphrase. Tab moves to the next field, Enter saves."
                   Foreground="#0A8F3C" />

        <TextBlock Grid.Row="2"
                   Margin="0,0,0,6"
                   Text="passphrase  (8+ characters, words are easier to remember)"
                   Foreground="#0A8F3C" />
        <PasswordBox x:Name="Pass1"
                     Grid.Row="3"
                     KeyDown="OnPass1KeyDown" />

        <TextBlock Grid.Row="4"
                   Margin="0,14,0,6"
                   Text="repeat passphrase"
                   Foreground="#0A8F3C" />
        <PasswordBox x:Name="Pass2"
                     Grid.Row="5"
                     KeyDown="OnPass2KeyDown" />

        <StackPanel Grid.Row="6">
            <TextBlock x:Name="ErrorText"
                       Margin="0,14,0,0"
                       Foreground="#FF5555"
                       TextWrapping="Wrap" />
            <TextBlock Margin="0,10,0,0"
                       Foreground="#0A5C28"
                       TextWrapping="Wrap"
                       Text="Stored as a PBKDF2-SHA256 hash in %APPDATA%\TermLock\config.json. No recovery code yet (Day 7). If you forget it, delete config.json and set a new one." />
        </StackPanel>

        <StackPanel Grid.Row="7"
                    Margin="0,18,0,0"
                    Orientation="Horizontal">
            <Button Content="[ save ]" Click="OnCreate" />
            <Button Content="[ quit ]" Click="OnQuit" />
        </StackPanel>
    </Grid>
</Window>
