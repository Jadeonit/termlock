<Window x:Class="TermLock.UI.NotificationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TermLock alerts"
        Width="720"
        Height="650"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="True"
        Background="Black"
        Foreground="#00FF66"
        FontFamily="Consolas"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#050505" />
            <Setter Property="Foreground" Value="#00FF66" />
            <Setter Property="CaretBrush" Value="#00FF66" />
            <Setter Property="BorderBrush" Value="#0A8F3C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#050505" />
            <Setter Property="Foreground" Value="#00FF66" />
            <Setter Property="BorderBrush" Value="#0A8F3C" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#00FF66" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="Black" />
            <Setter Property="Foreground" Value="#00FF66" />
            <Setter Property="BorderBrush" Value="#0A8F3C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="34,26" MouseLeftButtonDown="OnDrag">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="TERMLOCK // ALERTS"
                   FontSize="20"
                   Foreground="#00FF66" />

        <TextBlock Grid.Row="1"
                   Margin="0,8,0,14"
                   Foreground="#0A8F3C"
                   TextWrapping="Wrap"
                   Text="ntfy notifications for failed attempts. The topic is a secret: anyone who knows it can read and publish. Use a long random topic." />

        <TextBlock Grid.Row="2"
                   Margin="0,0,0,4"
                   Foreground="#0A8F3C"
                   Text="ntfy url" />
        <TextBox Grid.Row="3"
                 x:Name="UrlBox" />

        <TextBlock Grid.Row="4"
                   Margin="0,10,0,4"
                   Foreground="#0A8F3C"
                   Text="topic" />
        <TextBox Grid.Row="5"
                 x:Name="TopicBox" />

        <CheckBox Grid.Row="6"
                  x:Name="EnabledBox"
                  Margin="0,10,0,0"
                  Content="enabled" />

        <StackPanel Grid.Row="7"
                    Margin="0,10,0,0"
                    Orientation="Horizontal">
            <TextBlock Text="min interval (sec)   "
                       Foreground="#0A8F3C" />
            <TextBox x:Name="IntervalBox"
                     Width="90" />
        </StackPanel>

        <TextBlock Grid.Row="8"
                   Margin="0,18,0,4"
                   Foreground="#00FF66"
                   Text="AFTER 3 FAILED ATTEMPTS" />

        <TextBlock Grid.Row="9"
                   Margin="0,0,0,4"
                   Foreground="#0A8F3C"
                   Text="action" />
        <ComboBox Grid.Row="10"
                  x:Name="FailActionBox">
            <ComboBoxItem Content="Shutdown" />
            <ComboBoxItem Content="Sleep" />
            <ComboBoxItem Content="Hibernate" />
            <ComboBoxItem Content="Lock" />
            <ComboBoxItem Content="None" />
        </ComboBox>

        <StackPanel Grid.Row="11"
                    Margin="0,10,0,0"
                    Orientation="Horizontal">
            <TextBlock Text="countdown (sec)     "
                       Foreground="#0A8F3C" />
            <TextBox x:Name="FailSecondsBox"
                     Width="90" />
        </StackPanel>

        <TextBlock Grid.Row="12"
                   x:Name="StatusText"
                   Margin="0,14,0,0"
                   Foreground="#0A8F3C"
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="13"
                    Margin="0,12,0,0"
                    Orientation="Horizontal">
            <Button Content="[ test ]" Click="OnTest" />
            <Button Content="[ save ]" Click="OnSave" />
            <Button Content="[ close ]" Click="OnClose" />
        </StackPanel>
    </Grid>
</Window>
